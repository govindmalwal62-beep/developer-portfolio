{
  "entities": {
    "Message": {
      "title": "Contact Message",
      "description": "A contact form message from a visitor.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Visitor's name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Visitor's email address"
        },
        "subject": {
          "type": "string",
          "description": "Message subject"
        },
        "message": {
          "type": "string",
          "description": "Message content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time the message was sent"
        }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    },
    "Project": {
      "title": "Portfolio Project",
      "description": "A dynamic project displayed on the portfolio website.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "description": {
          "type": "string",
          "description": "Description of the project"
        },
        "image": {
          "type": "string",
          "description": "URL to the project's cover image"
        },
        "category": {
          "type": "string",
          "enum": ["AI", "Web Apps", "Games", "College Projects"],
          "description": "Category of the project"
        },
        "techStack": {
          "type": "array",
          "description": "List of technologies used in the project"
        },
        "liveUrl": {
          "type": "string",
          "description": "URL to the live demo of the project"
        },
        "githubUrl": {
          "type": "string",
          "description": "URL to the GitHub repository"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp for sorting"
        }
      },
      "required": ["title", "description", "category", "techStack", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of contact messages filled out by users."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of dynamic projects shown on the portfolio. Admins can add/edit/delete these records."
    }
  }
}
